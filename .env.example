# ==============================================================================
# RakshaNet Environment Configuration File Template
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=rakshanet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# Only used if running backend WITHOUT Docker. Ignored by docker-compose (it builds its own).
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:55432/rakshanet

# Neo4j Graph Database Configuration
# NEO4J_URI/USER below only used if running backend WITHOUT Docker.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Environment Mode (dev or prod)
ENV=dev

# JWT Authentication Secrets
JWT_SECRET=supersecretkeyforrakshanetdev

# Groq LLM API Configuration (used for NLP classification & evaluation)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173
